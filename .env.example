# Copy to .env for local development (never commit .env)
# For Render deployment, set these environment variables in the Render dashboard

# Flask Configuration
SECRET_KEY=change-me-local-dev
FLASK_DEBUG=1
PORT=5000

# Model Configuration
# Path to the model file (relative to project root)
# Supports .onnx (preferred for production) or .pt (PyTorch checkpoint)
MODEL_PATH=models/deploy/model.onnx

# Optional: URL to download model from if not in repo
# Used by build.sh to fetch model during deployment
# MODEL_URL=https://your-host.com/model.onnx

# Inference Configuration
DEVICE=cpu
MAX_UPLOAD_MB=50

# Optional: Directory configurations (defaults shown)
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs
