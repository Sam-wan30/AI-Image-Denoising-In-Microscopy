# Copy to .env for local development (never commit .env)

# Flask Configuration
SECRET_KEY=change-me-local-dev
FLASK_DEBUG=1
PORT=5000

# Model Configuration
# Path to the model file (relative to project root)
MODEL_PATH=models/deploy/model.pt

# Inference Configuration
DEVICE=cpu
MAX_UPLOAD_MB=50

# Optional: Directory configurations (defaults shown)
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs
