# Example secret values for local testing (DO NOT commit real secrets)
# Copy this file to .streamlit/secrets.toml and fill values before deploying to Streamlit Cloud

[default]
MODEL_PATH = "models/deploy/model.pt"  # Path inside the repo or in the deployment FS
MODEL_URL = ""  # Optional: public URL to download the model at runtime (http/https)
DEVICE = "cpu"
MAX_UPLOAD_MB = "50"
SECRET_KEY = "replace-me-with-random-secret"

# For Hugging Face / other services that require tokens
HF_TOKEN = ""
